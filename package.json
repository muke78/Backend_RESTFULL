{
	"name": "backend",
	"version": "1.0.0",
	"description": "Backend API for the project, using Node.js, Express, and MySQL.",
	"main": "server.js",
	"scripts": {
		"start": "node server.js",
		"dev": "nodemon server.js",
		"format": "pnpm exec biome format --write .",
		"lint": "pnpm exec biome lint --write .",
		"check:biome": "pnpm exec biome check --write .",
		"prepare": "husky",
		"test": "jest",
		"test:watch": "jest --watchAll",
		"test:with-server": "concurrently --kill-others --success first \"pnpm dev\" \"pnpm test\""
	},
	"license": "MIT",
	"type": "module",
	"author": "Khelde muke78 muke7881@gmail.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/muke78/Backend_RESTFULL.git"
	},
	"keywords": [
		"node",
		"express",
		"api",
		"backend",
		"mysql",
		"swagger"
	],
	"engines": {
		"node": ">=v22.11.0"
	},
	"dependencies": {
		"argon2": "^0.41.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"express": "^4.21.0",
		"express-rate-limit": "^7.5.0",
		"google-auth-library": "^9.15.1",
		"helmet": "^8.1.0",
		"husky": "^9.1.7",
		"joi": "17.13.3",
		"jsonwebtoken": "^9.0.2",
		"morgan": "^1.10.0",
		"mysql2": "^3.11.3",
		"swagger-themes": "^1.4.3",
		"swagger-ui-express": "^5.0.1",
		"winston": "3.17.0",
		"yamljs": "^0.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@faker-js/faker": "^9.7.0",
		"concurrently": "^9.2.0",
		"dotenv": "^16.5.0",
		"frisby": "^2.1.3",
		"globals": "^16.1.0",
		"jest": "^29.7.0",
		"nodemon": "^3.1.10"
	}
}
